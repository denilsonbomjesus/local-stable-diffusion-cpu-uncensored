# config/env.example - exemplo de variáveis de ambiente.
# Copie para env.local, ajuste e faça: source env.local antes de rodar os scripts.
# (env.local está no .gitignore e não vai para o repositório)

# Sobrescreve o modelo padrão (q5_0), se quiser usar outro GGUF
# MODEL_FILE="$PWD/models/CyberRealistic_V8_q8_0.gguf"

# Geração
WIDTH=512
HEIGHT=768
STEPS=24
CFG_SCALE=7
THREADS="$(nproc)"
DENOISE=0.45

# Servidor
PORT=39100
